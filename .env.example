# ── Required ──────────────────────────────────────────────────────────────────
GITLAB_TOKEN=glpat-xxxx...         # GitLab personal access token — api + read_api scopes
GITLAB_URL=https://gitlab.com

GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_LOCATION=us-central1
GEMINI_API_KEY=AIza...             # Google AI Studio → Get API key

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=necro_db

# ── Slack (optional — enables autonomous notifications) ───────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0...

# ── App ───────────────────────────────────────────────────────────────────────
APP_PORT=8080
APP_URL=https://necro-REPLACE.run.app
OUTPUT_DIR=outputs
DEMO_MODE=false

# ── Autonomous monitoring ─────────────────────────────────────────────────────
MONITOR_INTERVAL_HOURS=24

# ── Optional Vertex AI fallback ───────────────────────────────────────────────
# GEMINI_MODEL=gemini-2.5-flash    # fallback only — Gemini 3 is always tried first
